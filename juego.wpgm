import Arma.*
import wollok.game.*
import personaje.*
import Enemigo.*
import Nivel.*
import Pantalla.*
import Powerup.*
import Administracion.administracionEntidades

object juego{
  //const enemigosTotalesJuego = [LoboSuelto] (cada nivel decide que enemigos pueden aparecer) //   Aca irian todos los que tenemos, sin los bosses
  const cantidadNiveles = 1
  
  var personaje = null
  var fueIniciado = false
  //var cantidadEnemigosRonda = 3 (lo deciden los niveles)
  
  var nivel = 1
  //var tickAparicionEnemigos = 5000 (lo deciden los niveles)

  var nivelActual = new Nivel(cantidadEnemigosRonda=3, tickAparicionEnemigos= 5000, fondo = "nivel1.png") 

  method personaje() = personaje
  method nivelActual() = nivelActual  

  method iniciarNivel(){
    game.boardGround(nivelActual.fondo())
    
    game.onTick(nivelActual.tickAparicionEnemigos(), "crearEnemigos", {administracionEntidades.añadirEnemigo()})
    game.onTick(8000, "crearPowerUps", { administracionEntidades.añadirPowerUp() })
  }

  method terminarNivel(){
    game.removeTickEvent("crearEnemigos")
    game.removeTickEvent("crearPowerUps")
    if(nivel == cantidadNiveles){
      self.ganaste()
    }else{
      
      nivel += 1
      const cantidadEnemigosRonda = 10 + (nivel * 4)
      const tickAparicionEnemigos = 3000 - (nivel * 500)
      const fondo = "fondoNivel" + nivel + ".png"
      nivelActual= new Nivel(cantidadEnemigosRonda = cantidadEnemigosRonda, tickAparicionEnemigos = tickAparicionEnemigos, fondo = fondo)
      
      self.iniciarNivel()
    }
  }


  method cambiarPersonaje(nuevoPersonaje) {
    personaje = nuevoPersonaje
  }


  method iniciar() {
    //cada 5 segundos se crea un enemigo y despues cada un segundo busca al personaje
    //este tick los hacemos asi para que cuando llegue al tope de enemigos se pueda frenar
    game.addVisualCharacter(personaje)
    fueIniciado = true
    self.iniciarNivel()
    //game.onTick(tickAparicionEnemigos, "crearEnemigos", {self.añadirEnemigo()}) 

    administracionEntidades.iniciarTicks()
  }								

  method reiniciar() {

  }				

  method fueIniciado() = fueIniciado

  method ganaste() {
    administracionEntidades.frenarTicks()
    game.clear()
    game.addVisual(pantallaWin)
  }

  method perder() {
    game.removeTickEvent("crearEnemigos")
    game.removeTickEvent("crearPowerUps")
    administracionEntidades.frenarTicks()
    
    game.clear()
    game.addVisual(gameOver)
  }


}

program misaRicotera {
	game.title("La Misa Ricotera")
	game.height(15)
	game.width(15)
  game.cellSize(50)


	
	//juego.cambiarPersonaje(personaje)
  //administracionEntidades.cambiarPersonaje(personaje)
	
  var personaje = null
	game.addVisual(pantallaInicial)

	keyboard.enter().onPressDo({
    if(game.hasVisual(pantallaInicial)){
      game.removeVisual(pantallaInicial)
      if(!juego.fueIniciado()){
        personaje = pantallaInicial.obtenerPersonajeActual()
        juego.cambiarPersonaje(personaje)
        juego.iniciar()
      } else{
        juego.reiniciar()
      }
    }
    if(game.hasVisual(gameOver)){
      game.removeVisual(gameOver)
      game.addVisual(pantallaInicial)
    }
  })

  keyboard.right().onPressDo({
      if(game.hasVisual(pantallaInicial)){
        pantallaInicial.avanzarPersonaje()
      }
  })

    keyboard.left().onPressDo({
      if(game.hasVisual(pantallaInicial)){
        pantallaInicial.retrocederPersonaje()
      }
  })

	keyboard.w().onPressDo({personaje.dispararBala("balaArriba.png", false, 1)})
	keyboard.a().onPressDo({personaje.dispararBala("balaIzquierda.png", true,-1)})
	keyboard.s().onPressDo({personaje.dispararBala("balaAbajo.png", false,-1)})
	keyboard.d().onPressDo({personaje.dispararBala("balaDerecha.png", true, 1)})

  

	game.start()

}

