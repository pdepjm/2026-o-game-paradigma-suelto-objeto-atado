import wollok.game.*
import enemigos.Enemigo
import armas.Bala
import personajes.personaje

object pantallaPerder {

	method position() = game.center()
	method text() = "Perdiste"
}

object pantallaGanar {

	method position() = game.center()
	method text() = "Ganaste"
}



object juego {
  const enemigos = []
  const balas = []
  var cantidadEnemigosRonda = 3
  var cantidadEnemigosDerrotados = 0

  //los enemigos se mueven cada 1 segundo
  const tickMovimientoEnemigos = game.tick(1000, {self.moverEnemigos()}, false)
  //cada 100 milisegundos se mueven las balas disparadas por el personaje
  const tickMovimientoBalas= game.tick(100, {self.moverBalas()}, false)

  method iniciar() {
	//cada 5 segundos se crea un enemigo y despues cada un segundo busca al personaje
	//este tick los hacemos asi para que cuando llegue al tope de enemigos se pueda frenar
	game.onTick(5000, "crearEnemigos", {self.añadirEnemigo()}) 

	tickMovimientoBalas.start()
	tickMovimientoEnemigos.start()		
  }												


  method perder() {
	tickMovimientoBalas.stop()
	tickMovimientoEnemigos.stop()
	game.clear()
	game.addVisual(pantallaPerder)
  }

  method ganaste() {
	tickMovimientoBalas.stop()
	tickMovimientoEnemigos.stop()
	game.clear()
	game.addVisual(pantallaGanar)
  }

  method añadirEnemigo() {
	if(enemigos.size() < cantidadEnemigosRonda) {
		const nuevoEnemigo = new Enemigo()
		enemigos.add(nuevoEnemigo)
		game.addVisual(nuevoEnemigo)

		//REVISAR ESTA LINEA. al cruzarse entre enemigos, se hacen daño mutuamente. 
		game.onCollideDo(nuevoEnemigo, {objeto => objeto.chocarConElEnemigo(nuevoEnemigo)})


	}else {
		game.removeTickEvent("crearEnemigos")
	}
  }

  method moverEnemigos() {
	enemigos.forEach({enemigo => enemigo.perseguir(personaje)})
  }

  method eliminarEnemigo(enemigo) {
	enemigos.remove(enemigo)
	cantidadEnemigosDerrotados += 1
	if(cantidadEnemigosDerrotados == cantidadEnemigosRonda) {
		self.ganaste()
	}
  }

  method dispararBala(imagen, esHorizontal, movimiento) {
	const bala = new Bala(image = imagen,seMueveHorizontal = esHorizontal,cantidadCasillasMovimiento = movimiento)

	if(esHorizontal) {
		bala.cambiarPosicion(personaje.position().x() + movimiento, personaje.position().y())
	}else {
		bala.cambiarPosicion(personaje.position().x(), personaje.position().y() + movimiento)
	}

	game.addVisual(bala)
	balas.add(bala)
  }

  method moverBalas() {
	balas.forEach({bala => bala.mover()})
  }

  method eliminarBala(bala) {
	balas.remove(bala)
  }
}


program misaRicotera {
	game.title("La Misa Ricotera")
	game.height(10)
	game.width(10)

	game.addVisualCharacter(personaje)

	keyboard.w().onPressDo({juego.dispararBala("balaArriba.png", false, 1)})
	keyboard.a().onPressDo({juego.dispararBala("balaIzquierda.png", true,-1)})
	keyboard.s().onPressDo({juego.dispararBala("balaAbajo.png", false,-1)})
	keyboard.d().onPressDo({juego.dispararBala("balaDerecha.png", true, 1)})

	juego.iniciar()

	game.start()

}


