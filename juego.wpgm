import wollok.game.*
import enemigos.Enemigo
import armas.Bala

object pantallaPerder {

	method position() = game.center()
	method text() = "Perdiste"
}

object pantallaGanar {

	method position() = game.center()
	method text() = "Ganaste"
}



object juego {
	const enemigos = []
	const balas = []
	var cantidadEnemigosRonda = 3
	var cantidadEnemigosDerrotados = 0
	method perder() {
		game.clear()
		game.addVisual(pantallaPerder)
	}

	method ganaste() {
		game.clear()
		game.addVisual(pantallaGanar)
	}
	method añadirEnemigo() {
		if(enemigos.size() < cantidadEnemigosRonda) {
			const nuevoEnemigo = new Enemigo()
			enemigos.add(nuevoEnemigo)
			game.addVisual(nuevoEnemigo)
			game.onCollideDo(nuevoEnemigo, {arma => arma.chocarConElEnemigo(nuevoEnemigo)})
		}else {
			game.removeTickEvent("crearEnemigos")
		}
	}

	method moverEnemigos() {
		enemigos.forEach({enemigo => enemigo.perseguir(personaje)})
	}

	method eliminarEnemigo(enemigo) {
		enemigos.remove(enemigo)
		cantidadEnemigosDerrotados++
		if(cantidadEnemigosDerrotados == cantidadEnemigosRonda) {
			self.ganaste()
		}
	}

	method dispararDerecha() {
	const bala = new Bala(image = "balaDerecha.png",seMueveHorizontal = true,cantidadCasillasMovimiento = 1)
  	bala.cambiarPosicion(personaje.position().x()+1, personaje.position().y())
	game.addVisual(bala)
	balas.add(bala)
  }
  method dispararIzquierda() {
	const bala = new Bala(image = "balaIzquierda.png",seMueveHorizontal = true,cantidadCasillasMovimiento = (-1))
	bala.cambiarPosicion(personaje.position().x()-1, personaje.position().y())
	game.addVisual(bala)
	balas.add(bala)
  }
  method dispararAbajo() {
	const bala = new Bala(image = "balaAbajo.png",seMueveHorizontal = false,cantidadCasillasMovimiento = (-1))
	bala.cambiarPosicion(personaje.position().x(), personaje.position().y()-1)
	game.addVisual(bala)
	balas.add(bala)
  }
  method dispararArriba() {
	const bala = new Bala(image = "balaArriba.png",seMueveHorizontal = false,cantidadCasillasMovimiento = 1)
	bala.cambiarPosicion(personaje.position().x(), personaje.position().y()+1)
	game.addVisual(bala)
	balas.add(bala)
  }

  method moverBalas() {
	balas.forEach({bala => bala.mover()})
	}

	method eliminarBala(bala) {
		balas.remove(bala)
	}
}

object personaje {
  var vida = 100
  var image = "indio.png"
  var posicionInicial = game.center()
  var position = posicionInicial
  
  
  method vida() = vida

  method position() = position
  method position(nuevaPosition) {
	position = nuevaPosition
  }
  method image() = "indio.png"

  method cambiarPersonaje(nuevoPersonaje) {
	  image = nuevoPersonaje
  }

  method modificarVida(valor) {
	vida += valor
    if(vida <= 0 ) {
		game.say(self, "Perdi")
        juego.perder()
    }
  }

  method chocarConElEnemigo(enemigo) {
	self.modificarVida(-(enemigo.danio()))
	game.say(self, "Dolor")
  }
  
}


program misaRicotera {
	game.title("La Misa Ricotera")
	game.height(10)
	game.width(10)
	
	//VER COMO FRENAR LOS TICKS UNA VEZ SE PIERDE
	//cada 5 segundos se crea un enemigo y despues cada un segundo busca al personaje
	
	game.onTick(5000, "crearEnemigos", {juego.añadirEnemigo()}) //este tick los hacemos asi para que cuando llegue
	//al tope de enemigos se pueda frenar
	const tickMovimientoEnemigos = game.tick(1000, {juego.moverEnemigos()}, false)
	//cada 100 milisegundos se mueven las balas disparadas por el personaje
	const tickMovimientoBalas= game.tick(100, {juego.moverBalas()}, false)
	
	//colision de el personaje con los enemigos. Si pasa, se le saca vida al personaj
	game.addVisualCharacter(personaje)


	keyboard.a().onPressDo({juego.dispararIzquierda()})
	keyboard.d().onPressDo({juego.dispararDerecha()})
	keyboard.s().onPressDo({juego.dispararAbajo()})
	keyboard.w().onPressDo({juego.dispararArriba()})

	tickMovimientoBalas.start()
	tickMovimientoEnemigos.start()


	game.start()

	

	
}


