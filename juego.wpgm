import arma.*
import wollok.game.*
import personaje.*
import Enemigo.*
import Nivel.*
import Pantalla.*


class Juego{
  //const enemigosTotalesJuego = [LoboSuelto] (cada nivel decide que enemigos pueden aparecer) //   Aca irian todos los que tenemos, sin los bosses
  const enemigos = []
  //var cantidadEnemigosRonda = 3 (lo deciden los niveles)
  var cantidadEnemigosDerrotados = 0
  //var tickAparicionEnemigos = 5000 (lo deciden los niveles)

  //method cantidadEnemigosRonda() = cantidadEnemigosRonda
  //method tickAparicionEnemigos() = tickAparicionEnemigos  
  

  var nivelActual = nivel1 
  //los enemigos se mueven cada 1 segundo
  const tickMovimientoEnemigos = game.tick(1000, {self.moverEnemigos()}, false)
  //cada 100 milisegundos se mueven las balas disparadas por el personaje
  const tickMovimientoBalas= game.tick(100, {self.moverBalas()}, false)

  method iniciarNivel(){
    game.boardGround(nivelActual.fondo())

    game.onTick(nivelActual.tickAparicionEnemigos(), "crearEnemigos", {self.añadirEnemigo()})
  }

  method iniciar() {
	//cada 5 segundos se crea un enemigo y despues cada un segundo busca al personaje
	//este tick los hacemos asi para que cuando llegue al tope de enemigos se pueda frenar
  self.iniciarNivel()
  //game.onTick(tickAparicionEnemigos, "crearEnemigos", {self.añadirEnemigo()}) 

	tickMovimientoBalas.start()
	tickMovimientoEnemigos.start()		
  }												


  method perder() {
	tickMovimientoBalas.stop()
	tickMovimientoEnemigos.stop()
	game.clear()
	game.addVisual(gameOver)
  }

  method ganaste() {
	tickMovimientoBalas.stop()
	tickMovimientoEnemigos.stop()
	game.clear()
	game.addVisual(pantallaWin)
  }

  method terminarNivel(){
    if(nivelActual.esUltimoNivel()){
      self.ganaste //frase al estilo de "TERMINASTE EL JUEGOOO WOOW"
    }else{
      nivelActual=nivelActual.siguienteNivel()
      cantidadEnemigosDerrotados= 0
      self.iniciarNivel()
    }
  }

  method añadirEnemigo() {
	if(enemigos.size() < nivelActual.cantidadEnemigosRonda()) { 
		
		const nuevoEnemigo = nivelActual.enemigosPosibles().anyOne() //OJO ESTO AAAAA (new?? xq el enemigo hereda de Enemigos)
		enemigos.add(nuevoEnemigo)
		game.addVisual(nuevoEnemigo)

		//REVISAR ESTA LINEA. al cruzarse entre enemigos, se hacen daño mutuamente. 
		game.onCollideDo(nuevoEnemigo, {objeto => objeto.chocarConElEnemigo(nuevoEnemigo)})


	}else {
		game.removeTickEvent("crearEnemigos")
	}
  }

  method moverEnemigos() {
	enemigos.forEach({enemigo => enemigo.perseguir(personaje)})
  }

  method eliminarEnemigo(enemigo) {
	enemigos.remove(enemigo)
	cantidadEnemigosDerrotados += 1
	if(cantidadEnemigosDerrotados == nivelActual.cantidadEnemigosRonda()) {
		self.ganaste()
	}
  }

  

  method moverBalas() {
	balas.forEach({bala => bala.mover()})
  }

  method eliminarBala(bala) {
	balas.remove(bala)
  }
}

program misaRicotera {
	game.title("La Misa Ricotera")
	game.height(10)
	game.width(10)


	var personaje = indio
	
	const juego = new Juego()
	game.addVisualCharacter(personaje)

	game.addVisual(pantallaInicial)

	keyboard.enter().onPressDo({
    if(game.hasVisual(pantallaInicial)){
      game.removeVisual(pantallaInicial)
      if(!juego.fueIniciado()){
        juego.iniciarJuego()
      } else{
        juego.reiniciarJuego()
      }
    }
    if(game.hasVisual(gameOver)){
      game.removeVisual(gameOver)
      game.addVisual(pantallaInicial)
    }
  })

  keyboard.right().whilePressedDo({
      if(game.hasVisual(pantallaInicial)){
        pantallaInicial.avanzarPersonaje()
      }
    }, 500)

    keyboard.left().whilePressedDo({
      if(game.hasVisual(pantallaInicial)){
        pantallaInicial.retrocederPersonaje()
      }
    }, 500)

	keyboard.w().onPressDo({personaje.dispararBala("balaArriba.png", false, 1)})
	keyboard.a().onPressDo({personaje.dispararBala("balaIzquierda.png", true,-1)})
	keyboard.s().onPressDo({personaje.dispararBala("balaAbajo.png", false,-1)})
	keyboard.d().onPressDo({personaje.dispararBala("balaDerecha.png", true, 1)})

	juego.iniciar()

	game.start()

}


