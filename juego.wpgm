import Arma.*
import wollok.game.*
import personaje.*
import Enemigo.*
import Nivel.*
import Pantalla.*
import Powerup.*
import Administracion.administracionEntidades

object juego{
  const cantidadNiveles = 3
  
  var personaje = null
  var fueIniciado = false
  
  var nivel = 1

  var nivelActual = new Nivel(cantidadEnemigosRonda=3, tickAparicionEnemigos= 5000, image = "fondoNivel1.png") 

  method personaje() = personaje
  method nivelActual() = nivelActual  

  method iniciarNivel(){
    //game.addVisual(nivelActual) ver como agregar bien el fondo
    game.addVisual(nivelActual)
    
    game.onTick(nivelActual.tickAparicionEnemigos(), "crearEnemigos", {administracionEntidades.añadirEnemigo()})
    game.onTick(15000, "crearPowerUps", { administracionEntidades.añadirPowerUp() })
    game.addVisualCharacter(personaje)
  }

  method terminarNivel(){
    administracionEntidades.eliminarTicks()
    game.removeVisual(nivelActual)
    if(nivel == cantidadNiveles){
      self.ganaste()
    }else{
      
      nivel += 1
      game.removeVisual(personaje)
      game.addVisual(pantallaFinRonda)
    }
  }

  method arrancarNuevoNivel() {
    const cantidadEnemigosRonda = 3 + (nivel * 4)
    const tickAparicionEnemigos = 3000 - (nivel * 500)
    const fondo = "fondoNivel" + nivel + ".png"
    nivelActual= new Nivel(cantidadEnemigosRonda = cantidadEnemigosRonda, tickAparicionEnemigos = tickAparicionEnemigos, image = fondo)
      
    self.iniciarNivel()
  }

  method cambiarPersonaje(nuevoPersonaje) {
    personaje = nuevoPersonaje
  }


  method iniciar() {

    fueIniciado = true
    self.iniciarNivel()
    administracionEntidades.iniciarTicks()
  }								

  method reiniciar() {
    nivel = 1
    nivelActual = new Nivel(cantidadEnemigosRonda=3, tickAparicionEnemigos= 5000, image = "fondoNivel1.png")    
    
    // 1. Limpiamos las entidades y contadores
    administracionEntidades.reiniciar()
    
    // 2. Reseteamos la vida y posición del personaje
    personaje.reiniciar() 
    
    // 3. Iniciamos el nivel y los ticks de nuevo
    self.iniciarNivel()
    administracionEntidades.iniciarTicks()
  }

  method fueIniciado() = fueIniciado

  method ganaste() {
    administracionEntidades.frenarTicks()
    administracionEntidades.reiniciarContador()
    self.removerTicks()
    game.removeVisual(nivelActual)
    game.addVisual(pantallaWin)
  }

  method removerTicks() {
    game.removeTickEvent("crearEnemigos")
    game.removeTickEvent("crearPowerUps")
  }

  method perder() {
    administracionEntidades.frenarTicks()
    administracionEntidades.reiniciarContador()
    self.removerTicks()
    game.removeVisual(personaje)
    
    game.removeVisual(nivelActual)
    game.addVisual(gameOver)
  }


}

program misaRicotera {
  game.title("La Misa Ricotera")
  game.height(15)
  game.width(20)
  game.cellSize(50)
  
  var personaje = null
  game.addVisual(pantallaInicial)

  keyboard.enter().onPressDo({
    if(game.hasVisual(pantallaInicial)){
      game.removeVisual(pantallaInicial)
      personaje = pantallaInicial.obtenerPersonajeActual()
      juego.cambiarPersonaje(personaje)
      juego.iniciar()
    }
    if(game.hasVisual(pantallaWin)) {
      game.removeVisual(pantallaWin)
      game.addVisual(pantallaInicial)
    }
    if(game.hasVisual(gameOver)){
      game.removeVisual(gameOver)
      juego.reiniciar()
    }
    if(game.hasVisual(pantallaFinRonda)) {
      game.removeVisual(pantallaFinRonda)
      game.addVisualCharacter(personaje)
      juego.arrancarNuevoNivel()
    }
  })

  keyboard.r().onPressDo({
    if(game.hasVisual(gameOver)) {
      game.removeVisual(gameOver)
      game.addVisual(pantallaInicial)
    }
  })

  keyboard.right().onPressDo({
    if(game.hasVisual(pantallaInicial)){
      pantallaInicial.avanzarPersonaje()
    } else if (personaje != null) {
      personaje.cambiarDireccion("Derecha")
    }
  })

  keyboard.left().onPressDo({
    if(game.hasVisual(pantallaInicial)){
      pantallaInicial.retrocederPersonaje()
    } else if (personaje != null) {
      personaje.cambiarDireccion("Izquierda")
    }
  })

  keyboard.up().onPressDo({
    if (personaje != null) { personaje.cambiarDireccion("Arriba") }
  })
  
  keyboard.down().onPressDo({
    if (personaje != null) { personaje.cambiarDireccion("Derecha") }
  })

  // Controles de disparo protegidos
  keyboard.w().onPressDo({ if (personaje != null) { personaje.dispararBala("balaArriba.png", false, 1) } })
  keyboard.a().onPressDo({ if (personaje != null) { personaje.dispararBala("balaIzquierda.png", true, -1) } })
  keyboard.s().onPressDo({ if (personaje != null) { personaje.dispararBala("balaAbajo.png", false, -1) } })
  keyboard.d().onPressDo({ if (personaje != null) { personaje.dispararBala("balaDerecha.png", true, 1) } })

  game.start()
}
