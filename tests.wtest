import Enemigo.*
import Powerup.*
import Arma.*
import personaje.*
import juego.juego
import Administracion.administracionEntidades

describe "tests de los personajes" {
    test "el personaje pierde vida al chocar con un enemigo" {
        const personaje = indio
        const enemigo = new CorderoAtado()
        
        const vidaInicial = personaje.vida()
        personaje.chocarConElEnemigo(enemigo)
        
        assert.equals(vidaInicial - enemigo.danio(), personaje.vida())
    }

    test "el personaje agarra un powerup y su vida aumenta según el multiplicador del personaje" {
        const personaje = skay
        const powerUp = new Lentes()
        
        const vidaInicial = personaje.vida()
        personaje.agarrarPower(powerUp)
        const lista = personaje.getPowerUpBoost()
        if(lista.contains(powerUp)) {
            // El multiplicador de vida para skay es 2, y la vida del powerup es 3
            assert.equals(vidaInicial + (personaje.multiplicadorVidaBoost(powerUp.vida())), personaje.vida())
        }else{
            assert.equals(vidaInicial + powerUp.vida(), personaje.vida())
        }
    }
}

describe "tests de los enemigos" {

    test "CorderoAtado no se mueve" {
        const cordero = new CorderoAtado()
        const personaje = indio
        
        cordero.generarPosInicial()
        const posicionInicial = cordero.position()

        cordero.moverse(personaje)
        const posicionFinal = cordero.position()

        assert.equals(posicionInicial, posicionFinal)
    }

    test "El enemigo pierde vida" {
        const enemigo = new LoboSuelto()
        const vidaInicial = enemigo.vida()

        enemigo.cambiarVida(3)

        assert.equals(vidaInicial - 3, enemigo.vida())
    }
}

describe "tests para la administracion de entidades" {
    test "al añadir un enemigo, la cantidad de enemigos añadidos aumenta" {
        administracionEntidades.reiniciarContador()
        const cantidadInicial = administracionEntidades.getCantidadEnemigos()
        
        administracionEntidades.añadirEnemigo()
        
        assert.equals(cantidadInicial + 1, administracionEntidades.getCantidadEnemigos())
    }

