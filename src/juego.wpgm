  keyboard.left().onPressDo({juego.pantalla().apretarIzquierda(juego)})
  keyboard.up().onPressDo({juego.pantalla().apretarArriba(juego)})
  keyboard.down().onPressDo({juego.pantalla().apretarAbajo(juego)})
  keyboard.w().onPressDo({juego.pantalla().apretarW(juego)})
  keyboard.a().onPressDo({juego.pantalla().apretarA(juego)})
  keyboard.s().onPressDo({juego.pantalla().apretarS(juego)})
  keyboard.d().onPressDo({juego.pantalla().apretarD(juego)})

