import Arma.*
import wollok.game.*
import personaje.*
import Enemigo.*
import Nivel.*
import Pantalla.*
import Powerup.*
import Administracion.administracionEntidades

object juego{
  const cantidadNiveles = 3
  
  var property personaje = personajeNulo
   var property pantalla = pantallaInicial
  var fueIniciado = false
  
  var nivel = 1

  var property nivelActual = new Nivel(cantidadEnemigosRonda=3, tickAparicionEnemigos= 5000, image = "fondoNivel1.png") 

  method iniciarNivel(){
    //game.addVisual(nivelActual) ver como agregar bien el fondo
    game.addVisual(nivelActual)
    
    game.onTick(nivelActual.tickAparicionEnemigos(), "crearEnemigos", {administracionEntidades.añadirEnemigo()})
    game.onTick(15000, "crearPowerUps", { administracionEntidades.añadirPowerUp() })
    game.addVisualCharacter(personaje)
  }

  method terminarNivel(){
    administracionEntidades.eliminarTicks()
    game.removeVisual(nivelActual)
    if(nivel == cantidadNiveles){
      self.ganaste()
    }else{
      
      nivel += 1
      game.removeVisual(personaje)
      game.addVisual(pantallaFinRonda)
      pantalla = pantallaFinRonda
    }
  }

  method arrancarNuevoNivel() {
    const nivelAnterior = nivelActual

    const cantidadEnemigosRonda = 3 + (nivel * 4)
    const tickAparicionEnemigos = 3000 - (nivel * 500)
    const fondo = "fondoNivel" + nivel + ".png"
    
    const nuevoNivel = new Nivel(cantidadEnemigosRonda = cantidadEnemigosRonda, tickAparicionEnemigos = tickAparicionEnemigos, image = fondo)
   
    nivelAnterior.nivelSiguiente(nuevoNivel)
    nuevoNivel.nivelAnterior(nivelAnterior)
    nivelActual = nuevoNivel
    self.iniciarNivel()
  }

  method cambiarPersonaje(nuevoPersonaje) {
    personaje = nuevoPersonaje
  }


  method iniciar() {

    fueIniciado = true
    self.iniciarNivel()
    administracionEntidades.iniciarTicks()
  }								

  method reiniciar() {
    nivel = 1
    nivelActual = new Nivel(cantidadEnemigosRonda=3, tickAparicionEnemigos= 5000, image = "fondoNivel1.png")    
    
    // 1. Limpiamos las entidades y contadores
    administracionEntidades.reiniciar()
    
    // 2. Reseteamos la vida y posición del personaje
    personaje.reiniciar() 
    
    // 3. Iniciamos el nivel y los ticks de nuevo
    self.iniciarNivel()
    administracionEntidades.iniciarTicks()
  }

  method fueIniciado() = fueIniciado

  method ganaste() {
    administracionEntidades.frenarTicks()
    administracionEntidades.reiniciarContador()
    self.removerTicks()
    game.removeVisual(nivelActual)
    game.addVisual(pantallaWin)
    pantalla = pantallaWin
  }

  method removerTicks() {
    game.removeTickEvent("crearEnemigos")
    game.removeTickEvent("crearPowerUps")
  }

  method perder() {
    administracionEntidades.frenarTicks()
    administracionEntidades.reiniciarContador()
    self.removerTicks()
    game.removeVisual(personaje)
    
    game.removeVisual(nivelActual)
    game.addVisual(gameOver)
    pantalla = gameOver
  }


}

program misaRicotera {
  game.title("La Misa Ricotera")
  game.height(15)
  game.width(20)
  game.cellSize(50)
  
  var personaje = personajeNulo
  game.addVisual(pantallaInicial)

  method apretarW(unJuego){
    personaje.dispararBala("balaArriba.png", false, 1)
  }
  
  method apretarA(unJuego){
    personaje.dispararBala("balaIzquierda.png", false, -1)
  }
  
  method apretarS(unJuego){
    personaje.dispararBala("balaAbajo.png", false, -1)
  }

  method apretarD(unJuego){
    personaje.dispararBala("balaDerecha", false, 1)
