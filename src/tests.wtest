import Enemigo.*
import Powerup.*
import Arma.*
import personaje.*
import juego.juego
import Administracion.administracionEntidades
import Nivel.*
import Pantalla.*

class EnemigoTest {
    var movimientos = 0
    
    method moverse(personaje) {
        movimientos += 1
    }

    method movimientos() = movimientos
}

object jugadorPrueba {
    method position() = game.at(4,4)
}

describe "tests de los personajes" {
    test "el personaje pierde vida al chocar con un enemigo" {
        const personaje = indio
        const enemigo = new LoboSuelto()
        
        const vidaInicial = personaje.vida()
        personaje.chocarConElEnemigo(enemigo)
        
        assert.equals(vidaInicial - enemigo.danio(), personaje.vida())
    }

    test "el personaje agarra un powerUp estandar" {
        const vidaInicial = skay.vida()
        skay.agarrarPower(new Lentes())
        assert.equals(vidaInicial + 3, skay.vida())
    }

    test "el personaje agarra un powerUp benefisioso" {
        const vidaInicial = semilla.vida()
        semilla.agarrarPower(new Whisky())
        // (-2) del whisky + cantidadEnemigosRonda(esta seteado el nivel 1 => valor = 3) * 0,5
        assert.equals(vidaInicial - 2 + 3 * 0.5, semilla.vida() )
    }

    test "reiniciar restaura la vida, posicion, direccion y balas" {
        indio.reiniciar()
        indio.modificarVida(-3)
        indio.position(game.at(2, 3))
        indio.cambiarDireccion("Izquierda")
        indio.balas().add("balaDePrueba")

        indio.reiniciar()

        assert.equals(10, indio.vida())
        assert.equals(game.center(), indio.position())
        assert.equals("indioDerecha.png", indio.image())
        assert.equals(0, indio.balas().size())
    }
}

describe "tests de los enemigos" {
    const lobo = new LoboSuelto()
    const barba = new BarbaAzul()
    const luz = new LuzBelito()
    method initialize() {
        indio.position(game.at(5, 5))
    }

    test "CorderoAtado no se mueve" {
        const cordero = new CorderoAtado()
        indio.position(game.at(8, 8))
        cordero.posicionActual(5,5)
        cordero.moverse(indio)
        const posicionFinal = cordero.position()

        assert.equals(game.at(5,5), posicionFinal)
    }

    test "LoboSuelto prioriza su movimiento al eje x y se mueve hacia el personaje en el eje x, hacia izquierda" {
        lobo.posicionActual(6,3) // Posición inicial del lobo
        lobo.moverse(indio)
        //alcanza al personaje en el eje x
        assert.equals(game.at(5,3), lobo.position())
    }

    test "LoboSuelto se mueve hacia el personaje en el eje x, hacia derecha" {
        lobo.posicionActual(4,3) // Posición inicial del lobo
        lobo.moverse(indio)
        //alcanza al personaje en el eje x
        assert.equals(game.at(5,3), lobo.position())
    }

    test "LoboSuelto se mueve hacia el personaje en el eje y, hacia arriba" {
        lobo.posicionActual(5,3) 
        lobo.moverse(indio)
        //comienza a moverse en el eje y
        assert.equals(game.at(5,4),lobo.position())
    }

    test "LoboSuelto se mueve hacia el personaje en el eje y, hacia abajo" {
        lobo.posicionActual(5,7) 
        lobo.moverse(indio)
        //comienza a moverse en el eje y
        assert.equals(game.at(5,6),lobo.position())
    }
    
    test "LoboSuelto no se mueve porque ya esta en la misma posicion que el personaje" {
        lobo.posicionActual(5,5) 
        lobo.moverse(indio)
        const posicionFinal = lobo.position()
        assert.equals(game.at(5,5),posicionFinal)
    }

    test "BarbaAzul se mueve hacia el personaje en el eje x, hacia izquierda" {
        barba.posicionActual(6,3) 
        barba.moverse(indio)
        assert.equals(game.at(5,3), barba.position())
    }
    test "BarbaAzul se mueve hacia el personaje en el eje x, hacia derecha" {
        barba.posicionActual(4,3) 
        barba.moverse(indio)
        assert.equals(game.at(5,3), barba.position())
    }
    test "BarbaAzul se queda quieto si se encuentra en el mismo x que el personaje" {
        barba.posicionActual(5,3) 
        barba.moverse(indio)
        assert.equals(game.at(5,3), barba.position())
    }

    test "LuzBelito se mueve hacia el personaje en el eje y, hacia abajo" {
        luz.posicionActual(3,7) 
        luz.moverse(indio)
        assert.equals(game.at(3,6), luz.position())
    }
    test "LuzBelito se mueve hacia el personaje en el eje y, hacia arriba" {
        luz.posicionActual(3,3) 
        luz.moverse(indio)
        assert.equals(game.at(3,4), luz.position())
    }
    test "LuzBelito se queda quieto si esta en el mismo y que el personaje" {
        luz.posicionActual(3,5) 
        luz.moverse(indio)
        assert.equals(game.at(3,5), luz.position())
    }


    test "El enemigo pierde vida" {
        const enemigo = new LoboSuelto()
        const vidaInicial = enemigo.vida()

        enemigo.cambiarVida(3)

        assert.equals(vidaInicial - 3, enemigo.vida())
    }
}

describe "tests para la administracion de entidades" {

    test "añadirEnemigo agrega un enemigo a la lista" {
        const enemigosAlInicio = administracionEntidades.getCantidadEnemigos()
        administracionEntidades.añadirEnemigo(jugadorPrueba)
        administracionEntidades.añadirEnemigo(jugadorPrueba)

        assert.equals(enemigosAlInicio + 2, administracionEntidades.getCantidadEnemigos())
    }
    
    test "añadirEnemigo no agrega más enemigos de los permitidos por el nivel" {
        juego.nivelActual(new Nivel(cantidadEnemigosRonda=1, tickAparicionEnemigos=5000, image="fondoNivel1.png"))
        administracionEntidades.añadirEnemigo(jugadorPrueba)
        administracionEntidades.añadirEnemigo(jugadorPrueba)   
        //se llama 2 veces a añadirEnemigo, pero deberia añadirse solo 1
        assert.equals(1, administracionEntidades.cantidadEnemigosAñadidos())
    }

    test "eliminarEnemigo elimina al enemigo de la lista, pero el contador de enemigos añadidos no se modifica" {
        juego.nivelActual(new Nivel(cantidadEnemigosRonda=5, tickAparicionEnemigos=5000, image="fondoNivel1.png"))
        administracionEntidades.añadirEnemigo(jugadorPrueba)
        administracionEntidades.añadirEnemigo(jugadorPrueba)   

        //tomo a un enemigo de la lista y lo elimino
        const enemigo = administracionEntidades.enemigos().first()
        administracionEntidades.eliminarEnemigo(enemigo)

        assert.equals(1, administracionEntidades.getCantidadEnemigos())
        assert.equals(2, administracionEntidades.cantidadEnemigosAñadidos())

    }

    test "se mueven todos los enemigos cuando se llama a moverEnemigos" {
        const enemigo1 = new EnemigoTest()
        const enemigo2 = new EnemigoTest()
        juego.personaje(indio)
        administracionEntidades.enemigos().add(enemigo1)
        administracionEntidades.enemigos().add(enemigo2)

        administracionEntidades.moverEnemigos()

        assert.equals(1, enemigo1.movimientos())
        assert.equals(1, enemigo2.movimientos())
    }


}

describe "tests de armas" {

    test "modificarDanio aumenta el danio del arma" {
        const arma = new ArmaDeFuego(danio = 2)

        arma.modificarDanio(3)

        assert.equals(5, arma.danio())
    }

    test "una bala horizontal se mueve dos casillas en x" {
        const bala = new ArmaDeFuego(
            danio = 2,
            seMueveHorizontal = true,
            cantidadCasillasMovimiento = 2
        )
        bala.cambiarPosicion(5, 5)

        bala.mover()

        assert.equals(game.at(7, 5), bala.position())
    }

    test "una bala vertical se mueve una casilla en y" {
        const bala = new ArmaDeFuego(
            danio = 2,
            seMueveHorizontal = false,
            cantidadCasillasMovimiento = 1
        )
        bala.cambiarPosicion(5, 5)

        bala.mover()

        assert.equals(game.at(5, 6), bala.position())
    }
}


describe "tests de seleccion de personaje" {

    test "avanzar desde el ultimo personaje vuelve al primero" {
        pantallaInicial.personajeSeleccionado(4)

        pantallaInicial.avanzarPersonaje()

        assert.equals(0, pantallaInicial.personajeSeleccionado())
        assert.equals("pantallaInicial0.png", pantallaInicial.image())
    }

    test "retroceder desde el primero selecciona el ultimo" {
        pantallaInicial.personajeSeleccionado(0)

        pantallaInicial.retrocederPersonaje()

        assert.equals(4, pantallaInicial.personajeSeleccionado())
        assert.equals("pantallaInicial4.png", pantallaInicial.image())
    }
}
